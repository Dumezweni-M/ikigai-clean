// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NEON_DB")
}


model TaskItem {
  id          String   @id @default(cuid())
  taskItem    String
  pillar      String
  intensity   Int?
  isChecked   Boolean  @default(false)
  interval    String  
  duration    Int?
  targetDays  Int?
  createdAt   DateTime @default(now())
  lastCompletedAt DateTime?
  
  completions TaskCompletion[]
}

model TaskCompletion {
  id          String   @id @default(cuid())
  taskId      String
  completedAt DateTime @default(now())
  intensity   Int
  pillar      String

  task        TaskItem @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model AchievedGoals {
  id               String   @id @default(cuid())
  originalHabitId  String
  title            String
  pillar           String   // e.g., "Physical", "Intellectual", "Financial"
  
  // Aggregated Analytics
  finalCount       Int      // Total days completed
  targetDays       Int      // What the original goal was
  avgIntensity     Float    // Average intensity across all sessions
  avgFulfillment   Float    // Average fulfillment across all sessions
  
  // Temporal Data
  startedAt        DateTime
  achievedAt       DateTime @default(now())
}

